{
  "expo": {
    "name": "TruePace",
    "slug": "truepace",
    "owner": "kishanth-01",
    "scheme": "truepace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.truepace.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TruePace needs access to your location to accurately calculate your running distance and pace.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "TruePace tracks your running workout accurately while your phone is with you, even when the screen is locked.",
        "NSLocationAlwaysUsageDescription": "TruePace continues tracking your run in the background when your screen locks.",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "com.truepace.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "TruePace tracks your running workout accurately while your phone is with you, even when the screen is locked.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "androidForegroundServiceIcon": "./assets/android-icon-monochrome.png"
        }
      ]
    ]
  }
}

